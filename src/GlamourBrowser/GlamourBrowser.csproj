<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!-- The internal name in Dalamud (plugin id, config and data folder) comes from the assembly name; namespaces stay GlamourBrowser. -->
    <AssemblyName>ShyneesGlamourDresser</AssemblyName>
    <RootNamespace>GlamourBrowser</RootNamespace>
    <Version>0.7.1.0</Version>
    <Author>ShyneeAK</Author>
    <Name>Shynees Glamour Dresser</Name>
    <Punchline>A glamour grid with every item rendered on your own character.</Punchline>
    <Description>Browse every equippable item as a paged grid of tiles rendered on your own character: try outfits on live, filter by slot, source, jobs and ownership, preview dyes, keep a wishlist and build your own sets.</Description>
    <RepoUrl>https://github.com/ShyneeAK/GlamourBrowser</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/ShyneeAK/GlamourBrowser/main/src/GlamourBrowser/images/icon.png</IconUrl>
    <Tags>glamour;transmog</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlamourBrowser.Core\GlamourBrowser.Core.csproj" />
    <ProjectReference Include="..\GlamourBrowser.Sources\GlamourBrowser.Sources.csproj" />
    <!-- Ships with Dalamud; only for the VRAM figures of the debug memory line. -->
    <Reference Include="TerraFX.Interop.Windows" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK adds no None items by default. Dalamud shows images/icon.png next to the dll of a dev plugin; the installer uses IconUrl (the packager keeps images out of latest.zip). icon.svg is the source. -->
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
